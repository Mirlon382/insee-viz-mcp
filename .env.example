# Every value the server reads. Copy to `.env` and edit; `.env` is git-ignored.
# Lists are JSON, not comma-separated: ALLOWED_HOSTS='["mcp.example.com"]'

# ---- MCP server ------------------------------------------------------------------------------------------------------
# Sent to the client during the handshake and shown by inspector UIs.
MCP_NAME=Insee figures

# http: serve Streamable HTTP on POST /mcp, which is what a long-running server does -- clients
# reach it by URL (http://127.0.0.1:8000/mcp), and the container does the same.
# stdio: talk over the process's pipes instead, for a client that launches the process itself
# (Claude Desktop, editors): MCP_TRANSPORT=stdio.
MCP_TRANSPORT=http

# ---- HTTP server -----------------------------------------------------------------------------------------------------
# 0.0.0.0 listens on every interface, which is what a container needs.
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Host header allow-list, checked only on the http transport. "*" accepts any host and disables the
# check: set the real hostname before exposing the server, or it answers to any name pointed at its IP.
ALLOWED_HOSTS='["*"]'

# Browser origins allowed to call the server. Empty rejects every cross-origin browser request,
# which is correct until a browser-based client needs in.
ALLOWED_ORIGINS='[]'

# Peers whose X-Forwarded-For is believed. Widen it only to your reverse proxy or every caller
# behind it, otherwise a caller can forge the address the rate limiter keys on.
TRUSTED_PROXY_HOSTS='["127.0.0.1"]'

# ---- Figures ---------------------------------------------------------------------------------------------------------
# Where the SVG (and PNG when a rasteriser is installed) of every rendered figure is written.
# Unset: ~/.cache/insee-viz. The container sets this to its volume, /data.
# INSEE_VIZ_OUT=/data

# Pixel width of the rasterised PNG. 1840 = twice the 920 px canvas, so it stays crisp on a HiDPI
# screen. PNG output needs `rsvg-convert` (librsvg2-bin) or `magick` on PATH; without one, tools
# return the SVG only.
RASTER_WIDTH=1840

# ---- Rate limiting ---------------------------------------------------------------------------------------------------
# Per client address, sliding window: 100 requests per minute by default. Only the http transport
# is rate-limited; stdio has no caller address.
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=1

# ---- Logging ---------------------------------------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR. FastMCP's own middlewares log under `fastmcp.*`.
LOG_LEVEL=INFO
